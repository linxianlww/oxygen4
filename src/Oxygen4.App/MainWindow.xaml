<Window x:Class="Oxygen4.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Oxygen4 - 课堂效率工具" Height="680" Width="1000"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI"
        AllowsTransparency="False">
    <Window.Resources>
        <Storyboard x:Key="PageFadeIn">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3"/>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="10" To="0" Duration="0:0:0.3"/>
        </Storyboard>
        <Storyboard x:Key="WindowFadeIn">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.4"/>
        </Storyboard>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ========== 侧边栏 ========== -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- Logo 区域 -->
                <StackPanel DockPanel.Dock="Top" Margin="0,28,0,24">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="O₄" FontSize="30" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="Oxygen4" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                    </StackPanel>
                    <TextBlock Text="课堂效率工具" FontSize="11" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>

                <!-- 导航菜单 -->
                <ListBox x:Name="NavList" DockPanel.Dock="Top" Background="Transparent" BorderThickness="0" Margin="12,0"
                         SelectionChanged="NavList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBoxItem Style="{StaticResource NavItemStyle}" Tag="draw">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🎯" FontSize="16" Width="24" VerticalAlignment="Center"/>
                            <TextBlock Text="随机抽选" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Style="{StaticResource NavItemStyle}" Tag="names">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📋" FontSize="16" Width="24" VerticalAlignment="Center"/>
                            <TextBlock Text="名单管理" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Style="{StaticResource NavItemStyle}" Tag="chart">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📊" FontSize="16" Width="24" VerticalAlignment="Center"/>
                            <TextBlock Text="统计图表" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Style="{StaticResource NavItemStyle}" Tag="notify">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔔" FontSize="16" Width="24" VerticalAlignment="Center"/>
                            <TextBlock Text="通知测试" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Style="{StaticResource NavItemStyle}" Tag="settings">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙" FontSize="16" Width="24" VerticalAlignment="Center"/>
                            <TextBlock Text="设置" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Style="{StaticResource NavItemStyle}" Tag="about">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="ℹ" FontSize="16" Width="24" VerticalAlignment="Center"/>
                            <TextBlock Text="关于" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>

                <!-- 底部信息 -->
                <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,20">
                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="16,0,16,12"/>
                    <TextBlock Text="Oxygen4 © 咏叹调 Aria" FontSize="10" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="v4.0.260909" FontSize="10" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    <TextBlock x:Name="StatusText" Text="API: 运行中 :5001" FontSize="10" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ========== 主内容区域 ========== -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="ContentScroll">
            <Grid Margin="32,28,32,32">

                <!-- ===== 随机抽选页 ===== -->
                <Grid x:Name="PageDraw" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="0,0,0,24">
                        <TextBlock Text="随机抽选" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="加权随机算法，支持冷却机制与不重复多人抽选" FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="280"/>
                        </Grid.ColumnDefinitions>

                        <!-- 抽选结果卡片 -->
                        <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="28" Margin="0,0,12,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="抽选结果" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <ItemsControl Grid.Row="1" x:Name="DrawResultList" Margin="0,20,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource AccentBrush}" CornerRadius="10" Padding="22,12" Margin="6">
                                                <TextBlock Text="{Binding}" FontSize="20" FontWeight="Bold" Foreground="White"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,20,0,0">
                                    <Button Content="抽选 1 人" Style="{StaticResource PrimaryButton}" Click="DrawOne_Click" MinWidth="100" Margin="0,0,10,0"/>
                                    <Button Content="批量抽选" Style="{StaticResource PrimaryButton}" Click="DrawMultiple_Click" MinWidth="100" Margin="0,0,10,0"/>
                                    <Button Content="清空结果" Style="{StaticResource SecondaryButton}" Click="ClearResult_Click" MinWidth="80"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 抽选设置卡片 -->
                        <Border Grid.Column="1" Style="{StaticResource CardBorder}" Padding="20">
                            <StackPanel>
                                <TextBlock Text="抽选设置" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16"/>

                                <TextBlock Text="抽选人数" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                                <TextBox x:Name="DrawCount" Text="1" Margin="0,0,0,14"/>

                                <TextBlock Text="随机种子（留空随机）" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                                <TextBox x:Name="DrawSeed" Text="" Margin="0,0,0,14"/>

                                <CheckBox x:Name="DrawNotify" Content="抽选后发送 ClassIsland 通知" IsChecked="True" Margin="0,0,0,16"/>

                                <Border Background="{StaticResource AccentLightBrush}" CornerRadius="10" Padding="14" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="当前名单" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock x:Name="CurrentNamesbookText" Text="default" FontSize="15" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,2,0,0"/>
                                        <TextBlock x:Name="StudentCountText" Text="0 人" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="算法参数" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,8"/>
                                <TextBlock Text="惩罚基数: 0.1" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,3"/>
                                <TextBlock Text="惩罚增长: 0.02" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,3"/>
                                <TextBlock Text="RNA α: 0.6" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,3"/>
                                <TextBlock Text="冷却轮次: 20" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <!-- ===== 名单管理页 ===== -->
                <Grid x:Name="PageNames" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="0,0,0,24">
                        <TextBlock Text="名单管理" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="创建、切换、编辑学生名单池，支持加密存储与备份" FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 名单列表卡片 -->
                        <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="18" Margin="0,0,12,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="名单文件" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                                <ListBox Grid.Row="1" x:Name="NamesbookList" SelectionChanged="NamesbookList_SelectionChanged" BorderThickness="0" Background="Transparent"/>
                                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Content="新建" Style="{StaticResource PrimaryButton}" Click="NewNamesbook_Click" MinWidth="56" Padding="12,7" FontSize="12" Margin="0,0,6,0"/>
                                    <Button Content="重命名" Style="{StaticResource SecondaryButton}" Click="RenameNamesbook_Click" MinWidth="56" Padding="12,7" FontSize="12" Margin="0,0,6,0"/>
                                    <Button Content="删除" Style="{StaticResource DangerButton}" Click="DeleteNamesbook_Click" MinWidth="56" Padding="12,7" FontSize="12"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 名单内容卡片 -->
                        <Border Grid.Column="1" Style="{StaticResource CardBorder}" Padding="20">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                                    <TextBlock Text="名单内容" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    <Button Content="添加学生" Style="{StaticResource PrimaryButton}" Click="AddStudent_Click" Margin="14,0,8,0" Padding="14,7" FontSize="12"/>
                                    <Button Content="重置次数" Style="{StaticResource DangerButton}" Click="ResetCounts_Click" Padding="14,7" FontSize="12"/>
                                </StackPanel>
                                <ListView Grid.Row="1" x:Name="StudentListView" BorderThickness="0" Background="Transparent">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="序号" Width="60" DisplayMemberBinding="{Binding Index}"/>
                                            <GridViewColumn Header="姓名" Width="200" DisplayMemberBinding="{Binding Name}"/>
                                            <GridViewColumn Header="出场次数" Width="100" DisplayMemberBinding="{Binding Count}"/>
                                            <GridViewColumn Header="冷却" Width="80" DisplayMemberBinding="{Binding Cooldown}"/>
                                            <GridViewColumn Header="操作" Width="100">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Content="删除" Style="{StaticResource DangerButton}" Padding="10,4" FontSize="11"
                                                                Click="DeleteStudent_Click" Tag="{Binding Index}"/>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                                <TextBlock Grid.Row="2" x:Name="NamesbookStatusText" Text="" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,10,0,0"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- ===== 统计图表页 ===== -->
                <Grid x:Name="PageChart" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="0,0,0,24">
                        <TextBlock Text="统计图表" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="成员抽取次数与当前概率分布统计" FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="24">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                                <TextBlock Text="成员抽取次数统计" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                <Button Content="刷新图表" Style="{StaticResource PrimaryButton}" Click="RefreshChart_Click" Margin="14,0,8,0" Padding="14,7" FontSize="12"/>
                                <Button Content="保存图片" Style="{StaticResource SecondaryButton}" Click="SaveChart_Click" Padding="14,7" FontSize="12"/>
                            </StackPanel>
                            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                <Image x:Name="ChartImage" Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ===== 通知测试页 ===== -->
                <Grid x:Name="PageNotify" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="0,0,0,24">
                        <TextBlock Text="通知测试" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="向 NotifyIsland 发送测试通知，验证 ClassIsland 连接" FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="28">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- 标题参数 -->
                                <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                    <TextBlock Text="遮罩（标题）参数" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16"/>

                                    <TextBlock Text="标题 *" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="NotifyTitle" Text="上课提醒" Margin="0,0,0,12"/>

                                    <TextBlock Text="持续时长（秒）*" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="NotifyTitleDuration" Text="3" Margin="0,0,0,12"/>

                                    <TextBlock Text="语音内容" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="NotifyTitleVoice" Text="" Margin="0,0,0,12"/>

                                    <CheckBox x:Name="NotifyTitleSpeech" Content="启用语音播报" Margin="0,0,0,8"/>
                                    <CheckBox x:Name="NotifyEffect" Content="启用提醒特效" IsChecked="True"/>
                                </StackPanel>

                                <!-- 正文参数 -->
                                <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                    <TextBlock Text="正文（内容）参数" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16"/>

                                    <TextBlock Text="正文内容" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="NotifyContent" Text="" AcceptsReturn="True" Height="60" TextWrapping="Wrap" Margin="0,0,0,12" VerticalContentAlignment="Top"/>

                                    <TextBlock Text="持续时长（秒）" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="NotifyContentDuration" Text="5" Margin="0,0,0,12"/>

                                    <TextBlock Text="正文类型" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="NotifyContentType" Margin="0,0,0,12">
                                        <ComboBoxItem Content="simple（简单文本）" IsSelected="True"/>
                                        <ComboBoxItem Content="rolling（滚动文本）"/>
                                    </ComboBox>

                                    <CheckBox x:Name="NotifyContentSpeech" Content="正文启用语音播报" Margin="0,0,0,8"/>
                                    <CheckBox x:Name="NotifySound" Content="启用提醒音效" IsChecked="True"/>
                                </StackPanel>
                            </Grid>

                            <!-- 发送按钮 -->
                            <Button Grid.Row="1" Content="发送测试通知" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Margin="0,24,0,0" Padding="40,12" FontSize="14" Click="SendTestNotify_Click"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ===== 设置页 ===== -->
                <Grid x:Name="PageSettings" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="0,0,0,24">
                        <TextBlock Text="设置" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="配置 NotifyIsland 连接与调试选项" FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="28" MaxWidth="600" HorizontalAlignment="Left">
                        <StackPanel>
                            <TextBlock Text="NotifyIsland 连接设置" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16"/>

                            <TextBlock Text="NotifyIsland API 地址" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="NotifyIslandUrl" Text="http://localhost:5002/notify/" Margin="0,0,0,12"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                                <Button Content="测试连通性" Style="{StaticResource PrimaryButton}" Click="TestNotifyIsland_Click" Margin="0,0,10,0"/>
                                <TextBlock x:Name="NotifyIslandStatus" Text="" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>

                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,0,0,16"/>

                            <TextBlock Text="API 服务设置" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                            <TextBlock Text="本地 API 监听端口：5001（固定）" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,20"/>

                            <TextBlock Text="调试选项" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                            <CheckBox x:Name="NoClassIslandDebug" Content="无 ClassIsland 调试模式（跳过通知发送）" Margin="0,0,0,20"/>

                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,0,0,16"/>

                            <TextBlock Text="悬浮窗设置" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                            <TextBlock Text="将悬浮窗恢复到初始位置（屏幕右下角）" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,12"/>
                            <Button Content="复位悬浮窗位置" Style="{StaticResource SecondaryButton}" Click="ResetFloating_Click" HorizontalAlignment="Left" MinWidth="140"/>

                            <Button Content="保存设置" Style="{StaticResource PrimaryButton}" Click="SaveSettings_Click" HorizontalAlignment="Left" MinWidth="120" Margin="0,24,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ===== 关于页 ===== -->
                <Grid x:Name="PageAbout" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="0,0,0,24">
                        <TextBlock Text="关于" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    </StackPanel>

                    <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="40" MaxWidth="520" HorizontalAlignment="Left">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="O₄" FontSize="64" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Oxygen4" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                            <TextBlock Text="课堂效率工具合集" FontSize="14" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,4,0,28"/>

                            <Border Background="{StaticResource BgBrush}" CornerRadius="10" Padding="20" Width="380">
                                <StackPanel>
                                    <TextBlock Text="版本：4.0.260909 (Tetra)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                                    <TextBlock Text="作者：咏叹调 Aria" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                                    <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6">
                                        <Run Text="仓库："/>
                                        <Hyperlink NavigateUri="https://github.com/linxianlww/oxygen4" RequestNavigate="Hyperlink_RequestNavigate" Foreground="{StaticResource AccentBrush}">
                                            <Run Text="github.com/linxianlww/oxygen4"/>
                                        </Hyperlink>
                                    </TextBlock>
                                    <TextBlock Text="框架：.NET 8 / WPF" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                                    <TextBlock Text="Copyright © 咏叹调 Aria 2025-2027" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="依赖：ClassIsland（宿主） / NotifyIsland（API）" FontSize="11" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,24,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
