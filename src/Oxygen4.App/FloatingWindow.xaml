<Window x:Class="Oxygen4.FloatingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Width="148" Height="40"
        FontFamily="Microsoft YaHei UI">
    <Border x:Name="RootBorder" Background="#661A1A1E" CornerRadius="20">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="36"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="36"/>
            </Grid.ColumnDefinitions>

            <!-- 拖拽手柄（左侧）：高可见度双竖线 -->
            <Border Grid.Column="0" x:Name="DragArea" Background="#33FFFFFF" CornerRadius="20,0,0,20" Cursor="SizeAll">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#33FFFFFF"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#66FFFFFF"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Width="2" Height="14" Background="#CCCCCC" CornerRadius="1" Margin="2,0"/>
                    <Border Width="2" Height="14" Background="#CCCCCC" CornerRadius="1" Margin="2,0"/>
                </StackPanel>
            </Border>

            <!-- 抽选按钮（中间） -->
            <Button Grid.Column="1" x:Name="ActionButton" Click="ActionButton_Click"
                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                    ToolTip="随机抽选">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="Transparent" CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#2AFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#664A90D9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="O₄" FontSize="13" FontWeight="Bold" Foreground="#7FB8E6" VerticalAlignment="Center"/>
                    <TextBlock Text="抽选" FontSize="12" Foreground="#DDDDDD" VerticalAlignment="Center" Margin="4,0,0,0"/>
                </StackPanel>
            </Button>

            <!-- 设置按钮（右侧） -->
            <Button Grid.Column="2" x:Name="SettingsButton" Click="SettingsButton_Click"
                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                    ToolTip="设置">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="Transparent" CornerRadius="0,20,20,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#2AFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <TextBlock Text="⚙" FontSize="14" Foreground="#BBBBBB" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Button>
        </Grid>
    </Border>
</Window>
